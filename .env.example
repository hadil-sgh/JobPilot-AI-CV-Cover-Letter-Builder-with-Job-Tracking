# Copy to .env and replace every value. Never commit .env.
DB_PASSWORD=change_me
# At least 32 characters (HS256 key). Generate e.g. with: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
# 32 random bytes, base64 (used from Phase 8 for AES-GCM). e.g. openssl rand -base64 32
ENCRYPTION_KEY=base64_32_byte_key

# --- LLM (Ollama) ---
# Default (as in docs/PROJECT.md): Ollama runs in Docker and ollama-init pulls the models.
COMPOSE_PROFILES=docker-ollama
OLLAMA_BASE_URL=http://ollama:11434
# Alternative: a native Ollama on the host (faster with a GPU). Remove COMPOSE_PROFILES above and use:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
